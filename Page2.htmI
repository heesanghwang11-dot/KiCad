<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Membership Plans</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    body {
      background-color: #0f172a;
      color: #f8fafc;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2rem 1rem;
    }

    h1 {
      font-size: 2.2rem;
      margin-bottom: 0.5rem;
      text-align: center;
    }

    .subtitle {
      color: #94a3b8;
      margin-bottom: 2.5rem;
      text-align: center;
    }

    /* Two-Tier Grid */
    .plans-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
      gap: 2rem;
      width: 100%;
      max-width: 780px;
    }

    .plan-card {
      background: #1e293b;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 18px;
      padding: 2rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .plan-card.pro {
      border: 2px solid #818cf8;
      background: linear-gradient(180deg, rgba(99, 102, 241, 0.15) 0%, #1e293b 100%);
      position: relative;
    }

    .badge {
      position: absolute;
      top: -12px;
      right: 20px;
      background: linear-gradient(135deg, #6366f1, #ec4899);
      color: #fff;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.25rem 0.8rem;
      border-radius: 999px;
      text-transform: uppercase;
    }

    .plan-title {
      font-size: 1.5rem;
      font-weight: 700;
    }

    .plan-price {
      font-size: 2.5rem;
      font-weight: 800;
      margin: 0.8rem 0 1.2rem;
    }

    .plan-price span {
      font-size: 1rem;
      font-weight: 400;
      color: #94a3b8;
    }

    /* Buy Button */
    .buy-btn {
      width: 100%;
      padding: 0.9rem;
      border: none;
      border-radius: 10px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      transition: opacity 0.2s, transform 0.1s;
    }

    .buy-btn:active {
      transform: scale(0.98);
    }

    .btn-original {
      background: #334155;
      color: #fff;
    }

    .btn-original:hover {
      background: #475569;
    }

    .btn-pro {
      background: linear-gradient(135deg, #6366f1, #ec4899);
      color: #fff;
    }

    .btn-pro:hover {
      opacity: 0.9;
    }

    /* Benefits Underneath */
    .benefits-box {
      margin-top: 1.5rem;
      padding-top: 1.2rem;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .benefits-box h4 {
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #94a3b8;
      margin-bottom: 0.8rem;
    }

    .benefits-list {
      list-style: none;
    }

    .benefits-list li {
      margin-bottom: 0.6rem;
      font-size: 0.95rem;
      color: #e2e8f0;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .benefits-list li::before {
      content: "✓";
      color: #818cf8;
      font-weight: bold;
    }

    /* Modal Overlay */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(4px);
      align-items: center;
      justify-content: center;
      padding: 1rem;
      z-index: 1000;
    }

    .modal-overlay.active {
      display: flex;
    }

    .modal-box {
      background: #1e293b;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 16px;
      padding: 2rem;
      width: 100%;
      max-width: 400px;
      text-align: center;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    }

    .modal-box h3 {
      font-size: 1.35rem;
      margin-bottom: 0.6rem;
    }

    .modal-box p {
      color: #94a3b8;
      margin-bottom: 1.5rem;
    }

    .modal-actions {
      display: flex;
      gap: 1rem;
      justify-content: center;
    }

    .modal-btn {
      flex: 1;
      padding: 0.75rem 1rem;
      border: none;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
    }

    .btn-yes {
      background: #22c55e;
      color: #fff;
    }

    .btn-no {
      background: #ef4444;
      color: #fff;
    }

    .btn-done {
      background: #6366f1;
      color: #fff;
      width: 100%;
    }

    .name-input {
      width: 100%;
      padding: 0.8rem 1rem;
      border-radius: 8px;
      border: 1px solid #475569;
      background: #0f172a;
      color: #fff;
      font-size: 1rem;
      margin-bottom: 1rem;
      outline: none;
    }

    .name-input:focus {
      border-color: #818cf8;
    }

    .error-msg {
      color: #f87171;
      font-size: 0.85rem;
      margin-bottom: 0.8rem;
      display: none;
    }
  </style>
</head>
<body>

  <h1>Choose Your Support Tier</h1>
  <p class="subtitle">Select a monthly plan below to support.</p>

  <div class="plans-container">
    
    <!-- ORIGINAL TIER -->
    <div class="plan-card">
      <div>
        <div class="plan-title">Original</div>
        <div class="plan-price">$5 <span>/ month</span></div>
        <button class="buy-btn btn-original" onclick="openConfirm('Original ($5/month)')">Click to Buy</button>

        <div class="benefits-box">
          <h4>Benefits</h4>
          <ul class="benefits-list">
            <li>Official supporter badge</li>
            <li>Access to monthly updates</li>
            <li>Early previews of new posts</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- PRO TIER -->
    <div class="plan-card pro">
      <div class="badge">Pro</div>
      <div>
        <div class="plan-title">Pro</div>
        <div class="plan-price">$15 <span>/ month</span></div>
        <button class="buy-btn btn-pro" onclick="openConfirm('Pro ($15/month)')">Click to Buy</button>

        <div class="benefits-box">
          <h4>Benefits</h4>
          <ul class="benefits-list">
            <li>All Original tier benefits</li>
            <li>High-resolution exclusive downloads</li>
            <li>Behind-the-scenes content</li>
            <li>Priority requests & special shoutouts</li>
          </ul>
        </div>
      </div>
    </div>

  </div>

  <!-- INTERACTIVE POP-UP MODAL -->
  <div class="modal-overlay" id="purchaseModal">
    <div class="modal-box">
      
      <!-- Step 1: Confirmation -->
      <div id="stepConfirm">
        <h3>Are You Sure to Buy This?</h3>
        <p id="selectedPlanText">Selected Plan</p>
        <div class="modal-actions">
          <button class="modal-btn btn-yes" onclick="goToNameStep()">Yes</button>
          <button class="modal-btn btn-no" onclick="closeModal()">No</button>
        </div>
      </div>

      <!-- Step 2: Enter Name -->
      <div id="stepName" style="display: none;">
        <h3>Enter Your Name</h3>
        <p>Please type in your name to complete your support.</p>
        <input type="text" id="buyerName" class="name-input" placeholder="Your name..." />
        <div id="nameError" class="error-msg">Please enter your name first.</div>
        <button class="modal-btn btn-done" onclick="finishPurchase()">Done</button>
      </div>

      <!-- Step 3: Success Message -->
      <div id="stepSuccess" style="display: none;">
        <h3 style="color: #4ade80;">succesfully perchase!</h3>
        <p id="thankYouMsg">Thank you for your support!</p>
        <button class="modal-btn btn-original" style="width: 100%;" onclick="closeModal()">Close</button>
      </div>

    </div>
  </div>

  <script>
    const modal = document.getElementById('purchaseModal');
    const stepConfirm = document.getElementById('stepConfirm');
    const stepName = document.getElementById('stepName');
    const stepSuccess = document.getElementById('stepSuccess');
    const selectedPlanText = document.getElementById('selectedPlanText');
    const buyerNameInput = document.getElementById('buyerName');
    const nameError = document.getElementById('nameError');
    const thankYouMsg = document.getElementById('thankYouMsg');

    let currentPlan = '';

    function openConfirm(planName) {
      currentPlan = planName;
      selectedPlanText.textContent = planName;
      buyerNameInput.value = '';
      nameError.style.display = 'none';

      stepConfirm.style.display = 'block';
      stepName.style.display = 'none';
      stepSuccess.style.display = 'none';
      modal.classList.add('active');
    }

    function goToNameStep() {
      stepConfirm.style.display = 'none';
      stepName.style.display = 'block';
      buyerNameInput.focus();
    }

    function finishPurchase() {
      const name = buyerNameInput.value.trim();
      if (!name) {
        nameError.style.display = 'block';
        return;
      }
      nameError.style.display = 'none';
      thankYouMsg.textContent = `Thank you, ${name}, for choosing ${currentPlan}!`;
      stepName.style.display = 'none';
      stepSuccess.style.display = 'block';
    }

    function closeModal() {
      modal.classList.remove('active');
    }
  </script>

</body>
</html>
